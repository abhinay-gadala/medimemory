# ============================================================================
# MediMemory Environment Configuration Template
# ============================================================================
# Copy this file to .env before starting the backend or custom deployment.
# For the frontend-only demo, no environment variables are required.
# ============================================================================

# Frontend & Server Ports
PORT=5000
VITE_PORT=5173

# Base Path for Assets (Default: '/')
BASE_PATH=/

# Environment Mode ('development' | 'production')
NODE_ENV=development

# Logging Level ('fatal' | 'error' | 'warn' | 'info' | 'debug' | 'trace')
LOG_LEVEL=info

# Database Connection (Optional for demo mode; required when connecting PostgreSQL)
# Format: postgresql://<username>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/medimemory

# External AI Service Credentials (Optional: MediMemory demo runs with deterministic fallback)
AI_API_KEY=
API_BASE_URL=http://localhost:5000
